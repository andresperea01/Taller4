---
import MainLayout from "@layouts/MainLayout.astro";

const metrics = [
  { name: 'Tamaño del build', description: 'Mide los archivos que el navegador debe descargar.' },
  { name: 'TTFB', description: 'Mide el tiempo hasta que llega el primer byte del servidor.' },
  { name: 'Tiempo hasta interactivo', description: 'Mide cuándo la interfaz responde a la persona usuaria.' },
];
---

<MainLayout>
  <h1>Métricas de comparación</h1>
  <p class="lead">Estas métricas permiten analizar el comportamiento de una SPA y un sitio SSG.</p>

  <table class="table table-striped border">
    <thead>
      <tr><th>Métrica</th><th>Descripción</th></tr>
    </thead>
    <tbody>
      {metrics.map((metric) => <tr><td>{metric.name}</td><td>{metric.description}</td></tr>)}
    </tbody>
  </table>
</MainLayout>
